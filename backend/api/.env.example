# cargo run 할 때 api/.env 로 복사해서 쓴다 (.env는 저장소에 올리지 않음)
DATABASE_URL=postgres://goodmorning:goodmorning@localhost:5432/goodmorning
JWT_SECRET=dev-only-secret-change-me
BIND_ADDR=127.0.0.1:8080
RUN_MIGRATIONS=true
SEED_DEV_DATA=true
# 비우면 모든 출처 허용. 예: http://localhost:5000,https://bloodmoon3929.github.io
CORS_ORIGINS=
RUST_LOG=info,goodmorning_api=debug
